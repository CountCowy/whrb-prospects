# Copy to .env.local and fill in. .env.local is gitignored.
# Server-only (never exposed to the browser bundle)
SUPABASE_URL=https://kolfijjavwruwzctmnlx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-exposed duplicates (REQUIRED for @supabase/ssr in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://kolfijjavwruwzctmnlx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — error / APM tracking. Leave the DSNs blank to keep the SDK
# inert (instrumentation*.ts files gate Sentry.init on these vars). DSNs
# are NOT secret; the auth token IS.
#
# Vercel: configure SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN, SENTRY_ORG,
# SENTRY_PROJECT in Production + Preview + Development. Configure
# SENTRY_AUTH_TOKEN in Production + Preview only (used by build-time
# source-map upload).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional: pin the Sentry environment label. Defaults to VERCEL_ENV /
# 'development'. Set this if you run multiple non-Vercel envs and want
# distinct Sentry environments per deploy target.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
