# Monorepo-wide ignores. Per-project .gitignore files (e.g. whrb-prospects/.gitignore)
# still apply inside their own trees.

# OS / editor noise
.DS_Store
.idea/
.vscode/

# Claude Code per-user session state (local overrides, worktrees, screenshot archive).
# The infra/ui-verification-gates PR tracks .claude/hooks/, .claude/skills/, and
# .claude/settings.json so the UI-push gates apply to every clone — those paths
# stay out of the ignore below.
.claude/settings.local.json
.claude/worktrees/
.claude/screenshots/
.claude/scheduled_tasks.lock

# UI verification manifests — regenerated per /verify-ui and /review-ui run.
.ui-verified.json
.review-clean.json

# Env files — never commit secrets
.env
.env.local
.env.*.local
*.env

# Python
__pycache__/
*.pyc
.venv/

# Node / Next.js (whrb-web/ will populate these at Stage 5)
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# Pipeline artifacts — regenerable, keep out of git
cache/
whrb-prospects/output/
# Stage T2: cannabis-block manual overlay is admin-curated, reviewed via PR;
# `whrb-prospects/data/` is otherwise ignored (PDFs, cached fixtures).
whrb-prospects/data/*
!whrb-prospects/data/ccc_manual_blocklist.txt
